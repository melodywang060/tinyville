# Provider: gemini | openai | ollama | openrouter
LLM_PROVIDER=gemini
LLM_API_KEY=

# Optional overrides (defaults set per-provider in llm.py)
# LLM_BASE_URL=
# LLM_CHAT_MODEL=gemini-2.5-flash-lite
# LLM_EMBED_MODEL=text-embedding-004

# Test the sim without an API key:
# MOCK_LLM=1

# Sim tuning
# TICK_SECONDS=1.0          # wall-clock seconds between ticks when running
# SIM_MINUTES_PER_TICK=10   # game minutes per tick
# REFLECT_THRESHOLD=100     # importance-sum threshold that triggers reflection
